generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Real accounts. Seed/prototype members stay in src/data/members.ts.
model User {
  id                         String    @id @default(cuid())
  email                      String    @unique
  /// Email ownership confirmed via token. NEVER grants Verified badge.
  emailVerified              Boolean   @default(false)
  /// Identity verification only — set by admin/passport review later. Users cannot self-set.
  identityVerified           Boolean   @default(false)
  /// UNVERIFIED | PENDING | VERIFIED | REJECTED — badge only when VERIFIED
  identityVerificationStatus String    @default("UNVERIFIED")
  isAdmin                    Boolean   @default(false)
  /// USER | ADMIN. Keep isAdmin synchronized for legacy callers.
  role                       String    @default("USER")
  passwordHash               String?
  mustChangePassword         Boolean   @default(false)
  /// True once the adminsource account has created its first password. Never reset.
  adminPasswordCreated       Boolean   @default(false)
  passwordChangedAt          DateTime?
  /// Signup / display name (required at join).
  name                       String
  /// Unique URL-safe handle without @. Null until onboarding.
  username                   String?   @unique
  slug                       String?   @unique
  photo                      String    @default("")
  cover                      String    @default("")
  bio                        String    @default("")
  /// ≤160 chars. Blank for new users. Hidden on public UI when empty.
  publicDisplayMessage       String    @default("")
  city                       String    @default("")
  country                    String    @default("")
  memberType                 String    @default("")
  intent                     String    @default("both")
  /// JSON string[] of category names from global list.
  specialties                String    @default("[]")
  onboardingComplete         Boolean   @default(false)
  /// When false, excluded from Explore/search/feeds (admins, private accounts).
  isDiscoverable             Boolean   @default(true)
  /// Automated/test fixtures — excluded from public discovery.
  isTestAccount              Boolean   @default(false)
  /// Controlled showcase accounts — visible on Explore with “Showcase profile” badge.
  /// Not identity-verified; excluded from verification queues and real payment flows.
  isDemo                     Boolean   @default(false)
  /// Soft-delete marker; public surfaces exclude deleted users.
  deletedAt                  DateTime?
  /// Notification sound preferences
  notificationSoundsEnabled  Boolean   @default(true)
  /// low | medium | high
  notificationVolume         String    @default("medium")
  /// Deprecated permanent profile video — replaced by StoryClip. Kept for migration safety.
  profileVideoUrl            String    @default("")
  profileVideoPosterUrl      String    @default("")
  profileVideoPathname       String    @default("")
  profileVideoPosterPathname String    @default("")
  profileVideoMime           String    @default("")
  profileVideoDurationSec    Int?
  profileVideoSizeBytes      Int?
  profileVideoCaption        String    @default("")
  profileVideoUpdatedAt      DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sessions             Session[]
  emailTokens          EmailVerificationToken[]
  passwordTokens       PasswordResetToken[]
  networkLocations     NetworkLocation[]
  trips                Trip[]
  statuses             StatusUpdate[]
  opportunities        Opportunity[]
  listings             StockListing[]
  reviewsReceived      Review[]                      @relation("Reviewee")
  reviewsWritten       Review[]                      @relation("Reviewer")
  following            Follow[]                      @relation("Follower")
  rateLimitEvents      RateLimitEvent[]
  identityRequests     IdentityVerificationRequest[]
  verificationReviews  IdentityVerificationRequest[] @relation("VerificationReviewer")
  verificationAudits   VerificationAuditEvent[]
  conversationParts    ConversationParticipant[]
  messagesSent         Message[]                     @relation("MessageSender")
  sourcingSent         SourcingRequest[]             @relation("SourcingFrom")
  sourcingReceived     SourcingRequest[]             @relation("SourcingTo")
  transactionsAsBuyer  Transaction[]                 @relation("TxnBuyer")
  transactionsAsSeller Transaction[]                 @relation("TxnSeller")
  blockedConversations ConversationBlock[]
  paymentMethods       SellerPaymentMethod[]
  notifications        Notification[]
  storyClips           StoryClip[]
  storyViews           StoryView[]                   @relation("StoryViewer")
  storyReports         StoryReport[]                 @relation("StoryReporter")

  /// 0–3 trust band for procurement advances (admin-configurable).
  trustLevel                    Int     @default(0)
  /// When false, this account cannot receive procurement advances.
  procurementAdvancesEnabled    Boolean @default(true)
  stripeConnectAccount          StripeConnectAccount?
  protectedTxAsBuyer            ProtectedTransaction[] @relation("ProtectedTxnBuyer")
  protectedTxAsSeller           ProtectedTransaction[] @relation("ProtectedTxnSeller")
  paymentTicketsCreated         PaymentTicket[]        @relation("PaymentTicketCreator")
  financialAuditEvents          FinancialAuditEvent[]
  disputesOpened                DisputeCase[]          @relation("DisputeOpener")

  @@index([isDiscoverable, deletedAt, isTestAccount])
  @@index([isDemo])
  @@index([role, isAdmin])
  @@index([deletedAt])
  @@index([username])
  @@index([trustLevel])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Email address this token verifies (supports change-email).
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One-time set/reset password tokens. Expire and single-use.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// In-app notification centre events (no private message bodies).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OPPORTUNITY | STATUS | MESSAGE | SOURCING_REQUEST | LISTING_ENQUIRY | OPPORTUNITY_ENQUIRY | SYSTEM
  type      String
  title     String    @default("")
  body      String    @default("")
  href      String    @default("")
  actorId   String?
  actorName String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, type, createdAt])
}

model AccountDeletionAudit {
  id                 String   @id @default(cuid())
  /// Anonymised former user id (no PII)
  formerUserIdHash   String
  deletedAt          DateTime @default(now())
  storageCleanupOk   Boolean  @default(false)
  storageCleanupNote String   @default("")
  meta               String   @default("{}")

  @@index([deletedAt])
}

/// Retry queue for failed Blob object deletions.
model StorageCleanupJob {
  id          String    @id @default(cuid())
  urlOrPath   String
  kind        String    @default("blob")
  attempts    Int       @default(0)
  lastError   String    @default("")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([completedAt, createdAt])
}

model NetworkLocation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String
  country   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, sortOrder])
}

model Trip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String
  country   String
  /// ISO date YYYY-MM-DD
  arrival   String
  /// ISO date YYYY-MM-DD
  departure String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Newest non-expired status is the active one. Max 3 creates per calendar day.
model StatusUpdate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  postedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([userId, postedAt])
}

/// Multiple opportunities allowed. Closed/expired are not active. Max 3 new/day.
model Opportunity {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String
  city             String
  country          String
  category         String
  /// Optional window start (user-facing "Start Date").
  startsAt         DateTime?
  expiresAt        DateTime?
  closedAt         DateTime?
  postedAt         DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  conversations    Conversation[]
  sourcingRequests SourcingRequest[]
  transactions     Transaction[]

  @@index([userId, postedAt])
}

model StockListing {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  slug              String            @unique
  description       String            @default("")
  /// Product family — "clothing" today; other kinds can add attribute sets later.
  productKind       String            @default("clothing")
  category          String
  subcategory       String            @default("")
  /// Ordered image URLs (JSON string[]). First image is the cover.
  images            String            @default("[]")
  /// Normalized ordered image records; images remains the denormalized cache.
  listingImages     ListingImage[]
  /// Legacy free-text quantity (non-clothing / fallback). Prefer sizes for clothing.
  quantity          String            @default("")
  /// Clothing sizes JSON string[] — S, M, L, XL, XXL, Multiple sizes available
  sizes             String            @default("[]")
  material          String            @default("")
  brand             String            @default("")
  condition         String            @default("")
  colour            String            @default("")
  pattern           String            @default("")
  fit               String            @default("")
  gender            String            @default("")
  availability      String            @default("available")
  /// Marketplace lifecycle: AVAILABLE | RESERVED | SOLD | ARCHIVED
  saleStatus        String            @default("AVAILABLE")
  /// Legacy single location string — prefer shipFromCity/Country.
  location          String            @default("")
  shipFromCity      String            @default("")
  shipFromCountry   String            @default("")
  shippingAvailable Boolean           @default(false)
  price             Float?
  currency          String            @default("USD")
  /// Extensible attribute bag for future product kinds (JSON object).
  attributes        String            @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  conversations     Conversation[]
  sourcingRequests  SourcingRequest[]
  transactions      Transaction[]
  protectedTxns     ProtectedTransaction[]

  /// CONTACT_ONLY | PROTECTED_ONLY | INSTANT_ONLY | BOTH
  /// Existing listings default CONTACT_ONLY until the owner opts into Source Bridge payments.
  paymentOptions    String            @default("CONTACT_ONLY")
  /// Reserved quantity / size holds for active checkouts (JSON object).
  inventoryReserved String            @default("{}")

  @@index([userId])
  @@index([slug])
  @@index([productKind, category])
  @@index([saleStatus])
  @@index([userId, saleStatus])
  @@index([paymentOptions])
}

model ListingImage {
  id        String       @id @default(cuid())
  listingId String
  listing   StockListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int          @default(0)
  isCover   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@unique([listingId, url])
  @@index([listingId, sortOrder])
}

model Review {
  id            String       @id @default(cuid())
  revieweeId    String
  reviewee      User         @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerId    String?
  reviewer      User?        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  authorName    String
  rating        Int
  text          String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@unique([transactionId, reviewerId])
  @@index([revieweeId])
  @@index([transactionId])
}

/// followingId may reference a real User OR a seed member id (no FK on target).
model Follow {
  id              String   @id @default(cuid())
  followerId      String
  follower        User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId     String
  followingIsSeed Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

/// Global categories — only admins create/remove. Users select from this list.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @unique
  description String   @default("")
  image       String   @default("")
  createdAt   DateTime @default(now())
}

/// Server-side daily action counters (status / opportunity / message). Timezone: APP_TIMEZONE or UTC.
model RateLimitEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  /// Calendar day key YYYY-MM-DD in APP_TIMEZONE
  dayKey    String
  createdAt DateTime @default(now())

  @@index([userId, action, dayKey])
}

/// Passport / identity review — documents are private; badge only when VERIFIED.
model IdentityVerificationRequest {
  id                   String                   @id @default(cuid())
  userId               String
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Request statuses: DRAFT | PENDING | VERIFIED | REJECTED
  status               String                   @default("DRAFT")
  documentType         String                   @default("")
  /// passport | national_id | driving_licence
  notes                String                   @default("")
  rejectionReason      String                   @default("")
  reviewerId           String?
  reviewedByAdminId    String?
  reviewedByAdmin      User?                    @relation("VerificationReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  submittedAt          DateTime?
  documentDeletedAt    DateTime?
  adminEmailStatus     String                   @default("none")
  applicantEmailStatus String                   @default("none")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  documents            VerificationDocument[]
  auditEvents          VerificationAuditEvent[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model VerificationDocument {
  id        String                      @id @default(cuid())
  requestId String
  request   IdentityVerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// front | back | selfie
  kind      String
  /// Private Blob URL or pathname — never expose publicly
  url       String
  pathname  String                      @default("")
  mimeType  String                      @default("")
  sizeBytes Int                         @default(0)
  deletedAt DateTime?
  createdAt DateTime                    @default(now())

  @@index([requestId])
}

model VerificationAuditEvent {
  id          String                      @id @default(cuid())
  requestId   String
  request     IdentityVerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?                       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  meta        String                      @default("{}")
  createdAt   DateTime                    @default(now())

  @@index([requestId])
  @@index([createdAt])
  @@index([action])
}

/// Internal messaging thread between Source Bridge users.
model Conversation {
  id                String                    @id @default(cuid())
  subject           String                    @default("")
  /// listing | opportunity | sourcing | direct | trip | system
  contextType       String                    @default("direct")
  /// Canonical sorted "userA:userB" for 1:1 threads. Null for system/broadcast threads.
  pairKey           String?                   @unique
  listingId         String?
  listing           StockListing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  opportunityId     String?
  opportunity       Opportunity?              @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  tripId            String?
  sourcingRequestId String?                   @unique
  sourcingRequest   SourcingRequest?          @relation(fields: [sourcingRequestId], references: [id], onDelete: SetNull)
  closedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  lastMessageAt     DateTime?
  participants      ConversationParticipant[]
  messages          Message[]
  blocks            ConversationBlock[]
  transactions      Transaction[]
  paymentTickets    PaymentTicket[]
  protectedTxns     ProtectedTransaction[]

  @@index([updatedAt])
  @@index([listingId])
  @@index([opportunityId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id              String              @id @default(cuid())
  conversationId  String
  conversation    Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String?
  sender          User?               @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  body            String              @default("")
  messageType     String              @default("USER")
  systemEventType String              @default("")
  replyAllowed    Boolean             @default(true)
  createdAt       DateTime            @default(now())
  editedAt        DateTime?
  /// Client idempotency key for send retries
  clientMessageId String              @default("")
  /// Optional link to a Payment Ticket timeline card.
  paymentTicketId String?
  paymentTicket   PaymentTicket?      @relation(fields: [paymentTicketId], references: [id], onDelete: SetNull)
  attachments     MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, clientMessageId])
  @@index([paymentTicketId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  pathname  String   @default("")
  mimeType  String   @default("")
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  @@index([messageId])
}

model ConversationBlock {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model SourcingRequest {
  id              String        @id @default(cuid())
  fromUserId      String
  fromUser        User          @relation("SourcingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId        String
  toUser          User          @relation("SourcingTo", fields: [toUserId], references: [id], onDelete: Cascade)
  listingId       String?
  listing         StockListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  /// Primary description — what the sender is looking for
  message         String
  neededFrom      String        @default("")
  budget          String        @default("")
  /// ISO date YYYY-MM-DD or empty
  deadline        String        @default("")
  /// Ordered reference image URLs (JSON string[])
  referenceImages String        @default("[]")
  /// Client-supplied idempotency key to prevent duplicate submits
  clientRequestId String        @default("")
  status          String        @default("open")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation?
  transactions    Transaction[]
  paymentTickets  PaymentTicket[]
  protectedTxns   ProtectedTransaction[]

  @@index([fromUserId, toUserId])
  @@index([toUserId, createdAt])
  @@index([listingId])
  @@index([opportunityId])
  @@index([fromUserId, clientRequestId])
}

/// Lifecycle ready for future escrow — no payment processing yet.
model Transaction {
  id                      String               @id @default(cuid())
  /// REQUESTED | ACCEPTED | IN_PROGRESS | COMPLETED | CANCELLED | DISPUTED
  status                  String               @default("REQUESTED")
  buyerId                 String
  buyer                   User                 @relation("TxnBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId                String
  seller                  User                 @relation("TxnSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  conversationId          String?
  conversation            Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourcingRequestId       String?
  sourcingRequest         SourcingRequest?     @relation(fields: [sourcingRequestId], references: [id], onDelete: SetNull)
  listingId               String?
  listing                 StockListing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  opportunityId           String?
  opportunity             Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title                   String               @default("")
  notes                   String               @default("")
  amount                  Float?
  currency                String               @default("USD")
  /// card | crypto | contact | other
  paymentMethod           String               @default("")
  /// unpaid | pending | awaiting_confirmation | paid | refunded | failed | cancelled
  paymentStatus           String               @default("unpaid")
  selectedSize            String               @default("")
  stripeCheckoutSessionId String               @default("")
  stripePaymentIntentId   String               @default("")
  cryptoNetwork           String               @default("")
  cryptoWalletAddress     String               @default("")
  cryptoTransactionHash   String               @default("")
  buyerConfirmed          Boolean              @default(false)
  sellerConfirmed         Boolean              @default(false)
  /// none | held | released | refunded | disputed — future escrow
  escrowStatus            String               @default("none")
  platformFeeAmount       Float?
  sellerPayoutStatus      String               @default("none")
  paymentMethodId         String?
  paymentMethodRef        SellerPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  completedAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  reviews                 Review[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([conversationId])
  @@index([status, completedAt])
  @@index([paymentStatus])
  @@index([listingId, paymentStatus])
}

/// Flexible seller payment configuration (crypto wallets, future methods).
model SellerPaymentMethod {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// crypto | card_placeholder | other
  kind         String
  /// e.g. Bitcoin, Ethereum, USDT, USDC, or custom network name
  networkName  String        @default("")
  /// Wallet address or payment identifier — never private keys
  address      String        @default("")
  qrImageUrl   String        @default("")
  instructions String        @default("")
  enabled      Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@index([userId, enabled])
  @@index([userId, kind])
}

/// Ephemeral location Story clip — expires 24h after upload. Replaces permanent profile video.
model StoryClip {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoUrl             String
  blobPathname         String        @default("")
  thumbnailUrl         String        @default("")
  thumbnailBlobPathname String       @default("")
  durationSeconds      Int
  fileSizeBytes        Int           @default(0)
  mimeType             String        @default("")
  /// UPLOADING | PROCESSING | READY | ACTIVE | FAILED | EXPIRED | DELETED
  status               String        @default("ACTIVE")
  originalFilename     String        @default("")
  /// Client-generated id for idempotent finalisation after direct upload.
  uploadSessionId      String?
  /// "mux" for async-transcoded clips, "blob" for legacy direct-Blob clips.
  mediaProvider        String        @default("")
  muxUploadId          String?       @unique
  muxAssetId           String?
  muxPlaybackId        String?
  /// Safe, non-secret reason recorded when Mux processing fails.
  processingError      String        @default("")
  /// Set when the clip becomes publicly playable — expiresAt is derived from this.
  readyAt              DateTime?
  createdAt            DateTime      @default(now())
  expiresAt            DateTime
  deletedAt            DateTime?
  views                StoryView[]
  reports              StoryReport[]

  @@unique([uploadSessionId])
  @@index([userId, status, expiresAt])
  @@index([expiresAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([userId, blobPathname])
  @@index([muxAssetId])
}

/// Unique authenticated view of a Story clip (owner views excluded from public count).
model StoryView {
  id                   String    @id @default(cuid())
  storyClipId          String
  storyClip            StoryClip @relation(fields: [storyClipId], references: [id], onDelete: Cascade)
  viewerUserId         String?
  viewer               User?     @relation("StoryViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  anonymousSessionHash String?
  viewedAt             DateTime  @default(now())

  @@unique([storyClipId, viewerUserId])
  @@index([storyClipId, viewedAt])
  @@index([viewerUserId, viewedAt])
}

model StoryReport {
  id             String    @id @default(cuid())
  storyClipId    String
  storyClip      StoryClip @relation(fields: [storyClipId], references: [id], onDelete: Cascade)
  reporterUserId String
  reporter       User      @relation("StoryReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reason         String
  notes          String    @default("")
  /// OPEN | REVIEWED | DISMISSED | ACTIONED
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())

  @@unique([storyClipId, reporterUserId])
  @@index([storyClipId, createdAt])
  @@index([status, createdAt])
}

// ─── Protected Payments / Stripe Connect (TEST mode gated) ───────────────────
// Public UI: "Protected Payment" / "Protected Transaction" — never "escrow".
// Charge model: Separate Charges and Transfers (platform charge → transfer at release).

/// Singleton-style platform fee / inspection / trust thresholds (admin-editable).
model PlatformPaymentConfig {
  id                              String   @id @default("default")
  /// Basis points of item+shipping charged as Source Bridge Protection Fee (e.g. 350 = 3.5%).
  protectionFeeBps                Int      @default(350)
  /// Flat protection fee floor in minor units (USD cents default currency).
  protectionFeeFloorMinor         Int      @default(50)
  /// Seller service fee basis points (shown separately from protection fee).
  sellerServiceFeeBps             Int      @default(0)
  /// Direct Payment platform service fee bps (item+shipping). Not Protection Fee.
  directServiceFeeBps             Int      @default(350)
  /// Direct Payment service fee floor in minor units.
  directServiceFeeFloorMinor      Int      @default(50)
  /// Default inspection window hours after delivery confirmed by tracking.
  inspectionHours                 Int      @default(12)
  /// Minimum trust level (0–3) required for procurement advances.
  procurementMinTrustLevel        Int      @default(2)
  /// Global kill-switch for procurement advances (also gated by feature flag).
  procurementAdvancesGloballyOn   Boolean  @default(true)
  /// Allowed currencies (JSON string[]). Empty = USD only until expanded.
  allowedCurrenciesJson           String   @default("[\"USD\"]")
  /// Stripe platform country hint for Connect capability docs (ISO 3166-1 alpha-2).
  stripePlatformCountry           String   @default("")
  updatedAt                       DateTime @updatedAt
  createdAt                       DateTime @default(now())
}

/// Stripe Connect Express/Custom account linkage for a seller.
model StripeConnectAccount {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeAccountId       String    @unique
  /// TEST | LIVE — refuse mode conflicts with platform keys.
  stripeMode            String    @default("TEST")
  chargesEnabled        Boolean   @default(false)
  payoutsEnabled        Boolean   @default(false)
  detailsSubmitted      Boolean   @default(false)
  /// card_payments / transfers capability status JSON snapshot.
  capabilitiesJson      String    @default("{}")
  /// requirements currently_due / past_due JSON snapshot (no PII secrets).
  requirementsJson      String    @default("{}")
  country               String    @default("")
  defaultCurrency       String    @default("usd")
  email                 String    @default("")
  disabledReason        String    @default("")
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([stripeMode, chargesEnabled, payoutsEnabled])
}

/// Chat Payment Ticket — terms negotiation before funding. Both parties must approve same revision.
model PaymentTicket {
  id                    String    @id @default(cuid())
  conversationId        String
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User      @relation("PaymentTicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  buyerId               String
  sellerId              String
  listingId             String?
  /// Optional link to sourcing flow (one active agreement at a time per request).
  sourcingRequestId     String?
  sourcingRequest       SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: SetNull)
  /// DRAFT | PROPOSED | ACCEPTED | DECLINED | SUPERSEDED | CANCELLED | FUNDED
  status                String    @default("DRAFT")
  revision              Int       @default(1)
  /// SHA-256 of canonical terms JSON — pay only against matching hash.
  termsHash             String    @default("")
  title                 String    @default("")
  currency              String    @default("USD")
  itemCostMinor         Int       @default(0)
  shippingMinor         Int       @default(0)
  sellerServiceFeeMinor Int       @default(0)
  protectionFeeMinor    Int       @default(0)
  totalChargeMinor      Int       @default(0)
  /// PROTECTED | INSTANT
  paymentOption         String    @default("PROTECTED")
  procurementAdvanceAgreed Boolean @default(false)
  procurementAdvanceMinor  Int    @default(0)
  notes                 String    @default("")
  buyerApprovedRevision Int?
  sellerApprovedRevision Int?
  buyerApprovedAt       DateTime?
  sellerApprovedAt      DateTime?
  declinedById          String?
  declinedAt            DateTime?
  declineReason         String    @default("")
  supersededById        String?
  protectedTransactionId String?  @unique
  protectedTransaction  ProtectedTransaction? @relation(fields: [protectedTransactionId], references: [id], onDelete: SetNull)
  stripeMode            String    @default("TEST")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  messages              Message[]

  @@index([conversationId, createdAt])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, updatedAt])
  @@index([termsHash])
  @@index([sourcingRequestId, status])
}

/// Source Bridge–controlled protected transaction (Stripe is processor only).
model ProtectedTransaction {
  id                       String    @id @default(cuid())
  /// Domain state machine — transitions only via explicit domain actions.
  /// DRAFT | AWAITING_ACCEPTANCE | ACCEPTED | AWAITING_PAYMENT | FUNDED |
  /// PROCUREMENT_RELEASED | AWAITING_SHIPMENT | IN_TRANSIT | DELIVERED |
  /// IN_INSPECTION | READY_TO_RELEASE | RELEASED | REFUNDED | PARTIALLY_REFUNDED |
  /// DISPUTED | CANCELLED | FAILED
  status                   String    @default("DRAFT")
  /// CHAT_TICKET | PRODUCT_CHECKOUT
  origin                   String
  /// PROTECTED | INSTANT
  paymentOption            String    @default("PROTECTED")
  buyerId                  String
  buyer                    User      @relation("ProtectedTxnBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId                 String
  seller                   User      @relation("ProtectedTxnSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  conversationId           String?
  conversation             Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  listingId                String?
  listing                  StockListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// Optional link to sourcing request (for ticket / procurement flows).
  sourcingRequestId        String?
  sourcingRequest          SourcingRequest? @relation(fields: [sourcingRequestId], references: [id], onDelete: SetNull)
  paymentTicket            PaymentTicket?
  title                    String    @default("")
  currency                 String    @default("USD")
  /// TEST | LIVE
  stripeMode               String    @default("TEST")
  termsHash                String    @default("")
  termsVersion             Int       @default(1)
  itemCostMinor            Int       @default(0)
  shippingMinor            Int       @default(0)
  sellerServiceFeeMinor    Int       @default(0)
  protectionFeeMinor       Int       @default(0)
  totalChargeMinor         Int       @default(0)
  procurementAdvanceAgreed Boolean   @default(false)
  procurementAdvanceMinor  Int       @default(0)
  procurementTransferredMinor Int    @default(0)
  finalTransferredMinor    Int       @default(0)
  refundedMinor            Int       @default(0)
  stripePaymentIntentId    String    @default("")
  stripeCheckoutSessionId  String    @default("")
  stripeChargeId           String    @default("")
  sellerConnectAccountId   String    @default("")
  fundedAt                 DateTime?
  procurementReleasedAt    DateTime?
  shippedAt                DateTime?
  deliveredAt              DateTime?
  inspectionEndsAt         DateTime?
  releasedAt               DateTime?
  cancelledAt              DateTime?
  selectedSize             String    @default("")
  trackingProvider         String    @default("")
  trackingNumber           String    @default("")
  trackingCarrier          String    @default("")
  /// Normalized tracking status (see TrackingProvider).
  trackingStatus           String    @default("")
  /// Seller cannot self-declare tracked DELIVERED — only provider/admin.
  trackingDeliveredAt      DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  ledgerEntries            LedgerEntry[]
  auditEvents              FinancialAuditEvent[]
  trackingEvents           TrackingEvent[]
  disputes                 DisputeCase[]
  transferAttempts         TransferAttempt[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, updatedAt])
  @@index([stripeMode, status])
  @@index([stripePaymentIntentId])
  @@index([conversationId])
  @@index([listingId, status])
  @@index([inspectionEndsAt])
  @@index([sourcingRequestId, status])
}

/// Immutable financial ledger — never update amounts; append only.
model LedgerEntry {
  id                  String   @id @default(cuid())
  protectedTxnId      String
  protectedTxn        ProtectedTransaction @relation(fields: [protectedTxnId], references: [id], onDelete: Restrict)
  /// CHARGE | PROCUREMENT_TRANSFER | FINAL_TRANSFER | REFUND | FEE | ADJUSTMENT | DISPUTE_HOLD
  entryType           String
  /// CREDIT | DEBIT relative to platform books
  direction           String
  amountMinor         Int
  currency            String
  stripeMode          String   @default("TEST")
  stripeObjectId      String   @default("")
  stripeObjectType    String   @default("")
  /// Unique per Stripe write / domain action — enforces idempotency.
  idempotencyKey      String   @unique
  metaJson            String   @default("{}")
  createdAt           DateTime @default(now())

  @@index([protectedTxnId, createdAt])
  @@index([entryType, createdAt])
  @@index([stripeObjectId])
}

/// Idempotent Stripe transfer attempts (procurement + final release).
model TransferAttempt {
  id               String    @id @default(cuid())
  protectedTxnId   String
  protectedTxn     ProtectedTransaction @relation(fields: [protectedTxnId], references: [id], onDelete: Cascade)
  /// PROCUREMENT | FINAL
  kind             String
  amountMinor      Int
  currency         String
  stripeMode       String    @default("TEST")
  idempotencyKey   String    @unique
  /// PENDING | SUCCEEDED | FAILED | RECONCILED
  status           String    @default("PENDING")
  stripeTransferId String    @default("")
  failureCode      String    @default("")
  failureMessage   String    @default("")
  attemptCount     Int       @default(1)
  lastAttemptAt    DateTime  @default(now())
  succeededAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([protectedTxnId, kind])
  @@index([status, lastAttemptAt])
}

model FinancialAuditEvent {
  id             String   @id @default(cuid())
  protectedTxnId String?
  protectedTxn   ProtectedTransaction? @relation(fields: [protectedTxnId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorUser      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Domain action name (e.g. TICKET_ACCEPTED, FUNDED, RELEASE_FINAL).
  action         String
  reason         String   @default("")
  metaJson       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([protectedTxnId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model TrackingEvent {
  id             String   @id @default(cuid())
  protectedTxnId String
  protectedTxn   ProtectedTransaction @relation(fields: [protectedTxnId], references: [id], onDelete: Cascade)
  provider       String
  providerStatus String   @default("")
  /// LABEL_CREATED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | EXCEPTION | UNKNOWN
  normalizedStatus String @default("UNKNOWN")
  rawPayloadJson String   @default("{}")
  occurredAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([protectedTxnId, createdAt])
  @@index([normalizedStatus, createdAt])
}

model DisputeCase {
  id             String    @id @default(cuid())
  protectedTxnId String
  protectedTxn   ProtectedTransaction @relation(fields: [protectedTxnId], references: [id], onDelete: Cascade)
  openedById     String
  openedBy       User      @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  /// OPEN | UNDER_REVIEW | RESOLVED_BUYER | RESOLVED_SELLER | RESOLVED_SPLIT | CLOSED
  status         String    @default("OPEN")
  reason         String    @default("")
  details        String    @default("")
  resolutionNote String    @default("")
  resolvedById   String?
  resolvedAt     DateTime?
  stripeDisputeId String   @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([protectedTxnId])
  @@index([status, createdAt])
  @@index([openedById])
}

/// Processed Stripe/webhook event ids for at-least-once delivery dedupe.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String   @default("")
  stripeMode  String   @default("TEST")
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
}
