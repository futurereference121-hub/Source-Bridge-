# Source Bridge — environment variables
#
# Copy to `.env` for local development. Never commit real secrets.

# PostgreSQL connection string (Neon recommended for Vercel).
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signed session cookies (required in production).
SESSION_SECRET="change-me-to-a-long-random-string"

# Public app URL used in verification emails / links.
APP_URL="http://localhost:3000"

# Email provider: console | resend | smtp
# console = logs verify URL and returns it for in-app testing (default).
EMAIL_PROVIDER="console"
# EMAIL_FROM="Source Bridge <noreply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Calendar day for rate limits (IANA). Default UTC.
# APP_TIMEZONE="UTC"

# Image storage: vercel-blob (production) | local (dev fallback without token)
STORAGE_PROVIDER="vercel-blob"
# Created automatically when you add a Blob store in the Vercel dashboard,
# or paste a token from https://vercel.com/dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=
# Private Blob store for identity documents only. Never use the public token.
# When you connect a Private Blob store in Vercel, these are typically set
# automatically (Production + Preview + Development):
#   PRIVATE_BLOB_READ_WRITE_TOKEN
#   PRIVATE_BLOB_STORE_ID
#   PRIVATE_BLOB_WEBHOOK_PUBLIC_KEY  (unused by the app; reserved by Vercel)
# Redeploy after connecting the store so serverless functions pick them up.
PRIVATE_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_STORE_ID=
# Legacy alias still accepted by the app if present:
# BLOB_PRIVATE_READ_WRITE_TOKEN=

# Story video processing (Mux Video). Without these, Story uploads are rejected
# in production with STORY_STORAGE_FAILED — no raw originals are ever published.
# Create an access token at https://dashboard.mux.com → Settings → Access Tokens
# (Mux Video read+write), and a webhook pointing at:
#   https://YOUR_DOMAIN/api/webhooks/mux
# then copy that webhook's signing secret into MUX_WEBHOOK_SECRET.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=

# VERIFICATION_ADMIN_EMAIL="verification@example.com"
# VERIFICATION_DOCUMENT_RETENTION_DAYS=30
# ADMIN_BOOTSTRAP_EMAIL="adminsource@sourcebridge.local"
# Show prototype seed members on Explore (local demos only). Off in production.
# SHOW_SEED_MEMBERS=1
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDINARY_URL=

# ─── Protected Payments / Stripe Connect (TEST MODE ONLY) ───────────────────
# LIVE_PAYMENTS_ENABLED must remain false until legal + Connect go-live checklist.
# Charge model: Separate Charges and Transfers (platform charge → transfer at release).
#
# PAYMENTS_ENABLED=false
# CONNECT_ONBOARDING_ENABLED=false
#   Set true (Production + Preview) to allow TEST Connect onboarding only
#   (Account create / Account Link / status sync). Does not enable checkout
#   or transfers — those still require PAYMENTS_ENABLED (and related flags).
# PROTECTED_PAYMENTS_ENABLED=false
# INSTANT_PAYMENTS_ENABLED=false
# PROCUREMENT_ADVANCES_ENABLED=false
# TRACKING_AUTOMATION_ENABLED=false
# LIVE_PAYMENTS_ENABLED=false
#
# Stripe TEST keys only (sk_test_… / pk_test_…). Live keys are refused in code.
# STRIPE_SECRET_KEY_TEST=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=
# STRIPE_WEBHOOK_SECRET_TEST=
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/stripe
# Connect webhook events: account.updated, payment_intent.succeeded
#
# Optional tracking provider (defaults to mock):
# TRACKING_PROVIDER=mock
# TRACKING_PROVIDER_API_KEY=
#
# Cron for inspection releases (Authorization: Bearer …):
# CRON_SECRET=

