# Source Bridge — environment variables
#
# Copy to `.env` for local development. Never commit real secrets.

# PostgreSQL connection string (Neon recommended for Vercel).
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signed session cookies (required in production).
SESSION_SECRET="change-me-to-a-long-random-string"

# Public app URL used in verification emails / links.
APP_URL="http://localhost:3000"

# Email provider: console | resend | smtp
# console = logs verify URL and returns it for in-app testing (default).
EMAIL_PROVIDER="console"
# EMAIL_FROM="Source Bridge <noreply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Calendar day for rate limits (IANA). Default UTC.
# APP_TIMEZONE="UTC"

# Image storage: local | s3 | cloudinary | vercel-blob (only local implemented).
STORAGE_PROVIDER="local"
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDINARY_URL=
# BLOB_READ_WRITE_TOKEN=
