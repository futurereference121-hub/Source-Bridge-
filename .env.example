# Source Bridge — environment variables
#
# Copy to `.env` for local development. Never commit real secrets.

# PostgreSQL connection string (Neon recommended for Vercel).
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signed session cookies (required in production).
SESSION_SECRET="change-me-to-a-long-random-string"

# Public app URL used in verification emails / links.
APP_URL="http://localhost:3000"

# Email provider: console | resend | smtp
# console = logs verify URL and returns it for in-app testing (default).
EMAIL_PROVIDER="console"
# EMAIL_FROM="Source Bridge <noreply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Calendar day for rate limits (IANA). Default UTC.
# APP_TIMEZONE="UTC"

# Image storage: vercel-blob (production) | local (dev fallback without token)
STORAGE_PROVIDER="vercel-blob"
# Created automatically when you add a Blob store in the Vercel dashboard,
# or paste a token from https://vercel.com/dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=
# Private Blob store for identity documents only. Never use the public token.
# When you connect a Private Blob store in Vercel, these are typically set
# automatically (Production + Preview + Development):
#   PRIVATE_BLOB_READ_WRITE_TOKEN
#   PRIVATE_BLOB_STORE_ID
#   PRIVATE_BLOB_WEBHOOK_PUBLIC_KEY  (unused by the app; reserved by Vercel)
# Redeploy after connecting the store so serverless functions pick them up.
PRIVATE_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_STORE_ID=
# Legacy alias still accepted by the app if present:
# BLOB_PRIVATE_READ_WRITE_TOKEN=
# VERIFICATION_ADMIN_EMAIL="verification@example.com"
# VERIFICATION_DOCUMENT_RETENTION_DAYS=30
# ADMIN_BOOTSTRAP_EMAIL="adminsource@sourcebridge.local"
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDINARY_URL=
